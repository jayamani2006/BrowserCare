<Application x:Class="BrowserCare.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BrowserCare"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <local:SafetyToBrushConverter x:Key="SafetyBrushConverter"/>
            <!--
                BrowserCare palette. Dark neutral background/cards for the frame,
                but Safe/Review/Protected use real red/yellow/green so the status
                is readable at a glance, with blue as the secondary accent and
                near-white/near-black (never pure #FFF/#000) for text and background.
            -->
            <SolidColorBrush x:Key="Ink"        Color="#0A0A0B"/>  <!-- app background -->
            <SolidColorBrush x:Key="Panel"       Color="#131315"/>  <!-- sidebar -->
            <SolidColorBrush x:Key="Card"         Color="#1B1B1E"/>  <!-- cards/rows -->
            <SolidColorBrush x:Key="CardHover"     Color="#2A2A2E"/>
            <SolidColorBrush x:Key="Line"           Color="#35353A"/>  <!-- borders -->
            <SolidColorBrush x:Key="Slate"           Color="#A6A6AC"/>  <!-- secondary text — bright enough to read -->
            <SolidColorBrush x:Key="Silver"           Color="#C7C8CC"/>  <!-- neutral accent / primary buttons -->
            <SolidColorBrush x:Key="SilverBright"      Color="#E6E7EA"/>  <!-- hover accent -->
            <SolidColorBrush x:Key="FogWhite"           Color="#F8F8F6"/>  <!-- primary text, off-white -->

            <!-- Backward-compatible aliases used by existing pages -->
            <SolidColorBrush x:Key="BgDark" Color="#0A0A0B"/>
            <SolidColorBrush x:Key="BgPanel" Color="#131315"/>
            <SolidColorBrush x:Key="BgCard" Color="#1B1B1E"/>
            <SolidColorBrush x:Key="BorderSubtle" Color="#35353A"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#F8F8F6"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#A6A6AC"/>
            <!-- Real status colors: green/yellow/red, as requested -->
            <SolidColorBrush x:Key="SafeGreen" Color="#4CB56E"/>
            <SolidColorBrush x:Key="ReviewYellow" Color="#E0B84C"/>
            <SolidColorBrush x:Key="ProtectedRed" Color="#E0665E"/>

            <!-- ============ BUTTONS — sharp square edges, no rounding ============ -->
            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="18,10"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" SnapsToDevicePixels="True">
                                <Border.Background>
                                    <SolidColorBrush x:Name="BgBrush" Color="#F2F2F0"/>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}">
                                    <TextElement.Foreground>
                                        <SolidColorBrush x:Name="FgBrush" Color="#141414"/>
                                    </TextElement.Foreground>
                                </ContentPresenter>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#FFFFFF" Duration="0:0:0.08"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#F2F2F0" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#141414" Duration="0:0:0.07"/>
                                                <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#F2F2F0" Duration="0:0:0.07"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#F2F2F0" Duration="0:0:0.22"/>
                                                <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#141414" Duration="0:0:0.22"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#4A4A4E" Duration="0"/>
                                                <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#8A8A8E" Duration="0"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#F2F2F0" Duration="0"/>
                                                <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#141414" Duration="0"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button" x:Key="SecondaryButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="BorderBrush" Value="{StaticResource Silver}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                <Border.Background>
                                    <SolidColorBrush x:Name="BgBrush" Color="#F2F2F0"/>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}">
                                    <TextElement.Foreground>
                                        <SolidColorBrush x:Name="FgBrush" Color="#141414"/>
                                    </TextElement.Foreground>
                                </ContentPresenter>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#FFFFFF" Duration="0:0:0.08"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#F2F2F0" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#141414" Duration="0:0:0.07"/>
                                                <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#F2F2F0" Duration="0:0:0.07"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#F2F2F0" Duration="0:0:0.22"/>
                                                <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#141414" Duration="0:0:0.22"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#2A2A2E" Duration="0"/>
                                                <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#6A6A6E" Duration="0"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#F2F2F0" Duration="0"/>
                                                <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#141414" Duration="0"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A quiet button used for per-row actions (e.g. "Clean", "Delete") -->
            <Style TargetType="Button" x:Key="RowActionButton" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <!-- ============ TEXT INPUT — sharp square edges ============ -->
            <Style TargetType="TextBox" x:Key="FilterTextBox">
                <Setter Property="Background" Value="{StaticResource Card}"/>
                <Setter Property="Foreground" Value="{StaticResource FogWhite}"/>
                <Setter Property="CaretBrush" Value="{StaticResource FogWhite}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ ACCOUNT SELECTOR — square dropdown for single-account scoping ============
                 Needs a full template: without one, the closed box picks up our
                 dark styling but the dropdown POPUP falls back to the OS's default
                 light chrome — white background, near-white text. That mismatch is
                 what made the account list "not visible." -->
            <Style TargetType="ComboBoxItem" x:Key="AccountComboBoxItem">
                <Setter Property="Background" Value="{StaticResource Card}"/>
                <Setter Property="Foreground" Value="{StaticResource FogWhite}"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHover}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Silver}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox" x:Key="AccountComboBox">
                <Setter Property="Background" Value="{StaticResource Card}"/>
                <Setter Property="Foreground" Value="{StaticResource FogWhite}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Silver}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Width" Value="360"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource AccountComboBoxItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="Toggle"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Focusable="False" ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="1" Data="M0,0 L6,6 L12,0" Stroke="{StaticResource Silver}"
                                                          StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <TextBlock x:Name="SelectedContent"
                                           Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="{TemplateBinding Padding}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Silver}" BorderThickness="1"
                                            MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ SCAN / CLEANUP ANIMATION BAR ============
                 A sharp-edged track with a solid silver block that sweeps
                 back and forth — no gradients, no rounding, no color.
                 Toggle Visibility in code while an operation is running. -->
            <!-- ============ BACKGROUND PATTERNS ============
                 Faint vector textures (not raster images — none were supplied
                 as project assets) so the Dashboard and every other page read
                 as visually distinct at a glance, the way the reference
                 screenshots used different background treatments per section. -->
            <!-- ============ BACKGROUND PATTERNS ============
                 Faint vector textures (not raster images — none were supplied
                 as project assets) so the Dashboard and every other page read
                 as visually distinct at a glance. Replaced the earlier dot
                 pattern with a classic diamond/crosshatch grid — closer to
                 the reference patterns provided, not a "dotted" look. -->
            <DrawingBrush x:Key="DashboardPatternBrush" TileMode="Tile" Viewport="0,0,48,24" ViewportUnits="Absolute" Opacity="0.05">
                <DrawingBrush.Drawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource Silver}" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <!-- classic herringbone/parquet chevron -->
                                <LineGeometry StartPoint="0,24" EndPoint="24,0"/>
                                <LineGeometry StartPoint="24,0" EndPoint="48,24"/>
                                <LineGeometry StartPoint="0,0" EndPoint="12,12"/>
                                <LineGeometry StartPoint="36,12" EndPoint="48,0"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <DrawingBrush x:Key="DataPatternBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute" Opacity="0.045">
                <DrawingBrush.Drawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource Silver}" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <!-- classic diamond/crosshatch grid -->
                            <PathGeometry Figures="M0,16 L16,0 L32,16 L16,32 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <Style TargetType="ProgressBar" x:Key="ScanBar">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Background" Value="{StaticResource Card}"/>
                <Setter Property="Foreground" Value="{StaticResource Silver}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="IsIndeterminate" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <!-- ClipToBounds is the fix: without it, the chaser block visually
                                 escapes the track and looks like a second, disconnected bar. -->
                            <Grid ClipToBounds="True">
                                <Border Background="{TemplateBinding Background}"/>
                                <Border x:Name="PART_Chaser" Background="{TemplateBinding Foreground}"
                                        Width="80" Height="6" HorizontalAlignment="Left">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ChaserTransform" X="-80"/>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Border.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="ChaserTransform"
                                                        Storyboard.TargetProperty="X"
                                                        From="-80" To="360" Duration="0:0:0.9"
                                                        AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ CARDS / LAYOUT ============ -->
            <Style TargetType="TextBlock" x:Key="NavItem">
                <Setter Property="Foreground" Value="{StaticResource Slate}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="18,8"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style TargetType="Border" x:Key="SummaryCard">
                <Setter Property="Background" Value="{StaticResource Card}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Margin" Value="0,0,10,10"/>
                <Setter Property="MinWidth" Value="140"/>
            </Style>
            <Style TargetType="Border" x:Key="ProfileCard">
                <Setter Property="Background" Value="{StaticResource Card}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Silver}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="PageTitle">
                <Setter Property="Foreground" Value="{StaticResource FogWhite}"/>
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="HelpTopicTitle">
                <Setter Property="Foreground" Value="{StaticResource FogWhite}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,14,0,4"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="HelpTopicBody">
                <Setter Property="Foreground" Value="{StaticResource Slate}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource FogWhite}"/>
            </Style>

            <!-- ============ SCROLLBAR — visible, square, silver thumb ============
                 No explicit style existed before, so every ScrollViewer fell back to
                 the barely-visible thin default. This is set as the implicit style
                 (no x:Key) so every ScrollBar in the app picks it up automatically. -->
            <Style TargetType="Thumb" x:Key="ScrollThumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="ThumbBg" Background="{StaticResource Silver}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="ThumbBg" Storyboard.TargetProperty="Background.Color"
                                                                To="#E6E7EA" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="ThumbBg" Storyboard.TargetProperty="Background.Color"
                                                                To="#C7C8CC" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Background" Value="{StaticResource Panel}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" Margin="2,0"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
