<Window x:Class="BrowserCare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BrowserCare" Height="720" Width="1080" MinWidth="880" MinHeight="560"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="185"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,24">
                    <Image Source="Assets/logo.png" Width="28" Height="28" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="BrowserCare" Foreground="{StaticResource TextPrimary}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="Nav_Dashboard" Text="Dashboard" Style="{StaticResource NavItem}" Tag="Dashboard" MouseLeftButtonUp="NavItem_Click"/>
                <TextBlock x:Name="Nav_Profiles" Text="Profiles" Style="{StaticResource NavItem}" Tag="Profiles" MouseLeftButtonUp="NavItem_Click"/>
                <TextBlock x:Name="Nav_Storage" Text="Storage" Style="{StaticResource NavItem}" Tag="Storage" MouseLeftButtonUp="NavItem_Click"/>
                <TextBlock x:Name="Nav_History" Text="History" Style="{StaticResource NavItem}" Tag="History" MouseLeftButtonUp="NavItem_Click"/>
                <TextBlock x:Name="Nav_Downloads" Text="Downloads" Style="{StaticResource NavItem}" Tag="Downloads" MouseLeftButtonUp="NavItem_Click"/>
                <TextBlock x:Name="Nav_Extensions" Text="Extensions" Style="{StaticResource NavItem}" Tag="Extensions" MouseLeftButtonUp="NavItem_Click"/>
                <TextBlock x:Name="Nav_Cookies" Text="Cookies" Style="{StaticResource NavItem}" Tag="Cookies" MouseLeftButtonUp="NavItem_Click"/>
                <TextBlock x:Name="Nav_Cleanup" Text="Cleanup" Style="{StaticResource NavItem}" Tag="Cleanup" MouseLeftButtonUp="NavItem_Click"/>
                <TextBlock x:Name="Nav_Reports" Text="Reports" Style="{StaticResource NavItem}" Tag="Reports" MouseLeftButtonUp="NavItem_Click"/>
                <TextBlock x:Name="Nav_Help" Text="Help" Style="{StaticResource NavItem}" Tag="Help" MouseLeftButtonUp="NavItem_Click"/>
                <TextBlock x:Name="Nav_Settings" Text="Settings" Style="{StaticResource NavItem}" Tag="Settings" MouseLeftButtonUp="NavItem_Click"/>
                <TextBlock x:Name="Nav_Privacy" Text="Privacy" Style="{StaticResource NavItem}" Tag="Privacy" MouseLeftButtonUp="NavItem_Click"/>
                <TextBlock x:Name="Nav_About" Text="About" Style="{StaticResource NavItem}" Tag="About" MouseLeftButtonUp="NavItem_Click"/>
            </StackPanel>
        </Border>

        <!-- Page host: every page is a sibling Grid, visibility toggled in code-behind -->
        <Grid Grid.Column="1" Margin="28,18,28,18" Background="{StaticResource DataPatternBrush}">

            <!-- ================= DASHBOARD ================= -->
            <Grid x:Name="Page_Dashboard" Visibility="Visible" Background="{StaticResource DashboardPatternBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Chrome Storage" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                    <TextBlock x:Name="TotalSizeText" Text="—" Foreground="{StaticResource TextPrimary}" FontSize="40" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock x:Name="StatusText" Text="Chrome not scanned yet." Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <Grid Height="10" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SegSafe" Width="1*"/>
                            <ColumnDefinition x:Name="SegReview" Width="1*"/>
                            <ColumnDefinition x:Name="SegProtected" Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource SafeGreen}"/>
                        <Border Grid.Column="1" Background="{StaticResource ReviewYellow}"/>
                        <Border Grid.Column="2" Background="{StaticResource ProtectedRed}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Border Width="10" Height="10" Background="{StaticResource SafeGreen}" Margin="0,0,6,0"/>
                            <TextBlock Text="Safe" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <Border Width="10" Height="10" Background="{StaticResource ReviewYellow}" Margin="0,0,6,0"/>
                            <TextBlock Text="Review" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" Background="{StaticResource ProtectedRed}" Margin="0,0,6,0"/>
                            <TextBlock Text="Protected" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,24,0">
                            <Run Text="PC: "/><Run x:Name="PcNameText" Text="—" Foreground="{StaticResource FogWhite}"/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12">
                            <Run Text="Chrome: "/><Run x:Name="ChromePathText" Text="—" Foreground="{StaticResource FogWhite}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,14,0,20">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Quick Scan" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="QuickScan_Click"/>
                        <Button Content="Deep Scan" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="DeepScan_Click"/>
                        <Button x:Name="CancelScanButton" Content="Cancel Scan" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="CancelScan_Click"/>
                    </StackPanel>
                    <ProgressBar x:Name="ScanProgressBar" Style="{StaticResource ScanBar}" Margin="0,10,0,0" Width="360" HorizontalAlignment="Left" Visibility="Collapsed"/>
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,16">
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="Safe to clean" Foreground="{StaticResource SafeGreen}" FontSize="12"/>
                                    <TextBlock x:Name="SafeSizeText" Text="0 B" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="Review" Foreground="{StaticResource ReviewYellow}" FontSize="12"/>
                                    <TextBlock x:Name="ReviewSizeText" Text="0 B" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="Protected" Foreground="{StaticResource ProtectedRed}" FontSize="12"/>
                                    <TextBlock x:Name="ProtectedSizeText" Text="0 B" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="Profiles" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <TextBlock x:Name="ProfileCountText" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                            <ItemsControl x:Name="ProfilesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ProfileCard}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SizeDisplay}" Foreground="{StaticResource Silver}" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding FolderName}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding AccountLabel}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Right rail: quick actions, using space that used to sit empty -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Quick Actions" Foreground="{StaticResource FogWhite}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Style="{StaticResource ProfileCard}" Cursor="Hand" MouseLeftButtonUp="QuickAction_Cleanup">
                            <StackPanel>
                                <TextBlock Text="Cleanup" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Review and clean Safe items" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ProfileCard}" Cursor="Hand" MouseLeftButtonUp="QuickAction_History">
                            <StackPanel>
                                <TextBlock Text="History" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Search or clear browsing history" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ProfileCard}" Cursor="Hand" MouseLeftButtonUp="QuickAction_Reports">
                            <StackPanel>
                                <TextBlock Text="Reports" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Generate a scan report" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Tip" Foreground="{StaticResource FogWhite}" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,10"/>
                        <Border Style="{StaticResource ProfileCard}">
                            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                       Text="Quick Scan checks disposable caches only — always safe and fast. Run Deep Scan occasionally to also see site storage and extensions."/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ================= PROFILES ================= -->
            <Grid x:Name="Page_Profiles" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Profiles" Style="{StaticResource PageTitle}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                    <StackPanel>
                        <TextBlock x:Name="ProfilesPageEmptyText" Text="Run a scan from the Dashboard first." Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="ProfilesDetailList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProfileCard}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SizeDisplay}" Foreground="{StaticResource Silver}" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AccountLabel}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="70"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Safety}" Foreground="{Binding Safety, Converter={StaticResource SafetyBrushConverter}}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="3" Content="Clean"
                                                                    Tag="{Binding}" Click="CleanSingleItem_Click">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CanClean}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= STORAGE ================= -->
            <Grid x:Name="Page_Storage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Storage" Style="{StaticResource PageTitle}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                    <StackPanel>
                        <TextBlock x:Name="StoragePageEmptyText" Text="Run a scan from the Dashboard first." Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="StorageCategoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProfileCard}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Foreground="{StaticResource Silver}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Safety}" Foreground="{Binding Safety, Converter={StaticResource SafetyBrushConverter}}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Content="Details" Style="{StaticResource RowActionButton}" Tag="{Binding}" Click="ToggleCategoryDetails_Click"/>
                                                <Button Grid.Column="4" Content="Clean" Tag="{Binding}" Click="CleanCategory_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanClean}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding ProfileShares}" Margin="0,8,0,0">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="100"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= HISTORY ================= -->
            <Grid x:Name="Page_History" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="History" Style="{StaticResource PageTitle}"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Account" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="HistoryAccountSelector" Style="{StaticResource AccountComboBox}" DisplayMemberPath="Label" SelectionChanged="HistoryAccountSelector_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Analyze History" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="AnalyzeHistory_Click"/>
                    <Button Content="Delete ALL History" Style="{StaticResource SecondaryButton}" Click="DeleteAllHistory_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,14">
                    <TextBlock Text="Filter by domain or keyword" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="HistoryFilterBox" Style="{StaticResource FilterTextBox}" Width="320" HorizontalAlignment="Left"
                             KeyDown="HistoryFilterBox_KeyDown"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Date:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="DateFilter_Today" Content="Today" Style="{StaticResource RowActionButton}" Margin="0,0,6,0" Tag="1" Click="HistoryDateFilter_Click"/>
                        <Button x:Name="DateFilter_7d" Content="7 Days" Style="{StaticResource RowActionButton}" Margin="0,0,6,0" Tag="7" Click="HistoryDateFilter_Click"/>
                        <Button x:Name="DateFilter_30d" Content="30 Days" Style="{StaticResource RowActionButton}" Margin="0,0,6,0" Tag="30" Click="HistoryDateFilter_Click"/>
                        <Button x:Name="DateFilter_All" Content="All Time" Style="{StaticResource RowActionButton}" Margin="0,0,16,0" Tag="0" Click="HistoryDateFilter_Click"/>
                        <TextBlock Text="Sort:" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="SortFilter_Visited" Content="Most Visited" Style="{StaticResource RowActionButton}" Margin="0,0,6,0" Click="HistorySortMostVisited_Click"/>
                        <Button x:Name="SortFilter_Recent" Content="Most Recent" Style="{StaticResource RowActionButton}" Click="HistorySortMostRecent_Click"/>
                    </StackPanel>
                    <ProgressBar x:Name="HistoryProgressBar" Style="{StaticResource ScanBar}" Margin="0,10,0,0" Width="320" HorizontalAlignment="Left" Visibility="Collapsed"/>
                </StackPanel>

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                    <StackPanel x:Name="HistoryResultsPanel">
                        <TextBlock Text="Reads Chrome's History database directly (read-only for browsing, direct write only for an explicit delete). Chrome must be closed before deleting." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= DOWNLOADS ================= -->
            <Grid x:Name="Page_Downloads" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Downloads" Style="{StaticResource PageTitle}"/>
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Account" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="DownloadsAccountSelector" Style="{StaticResource AccountComboBox}" DisplayMemberPath="Label"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Analyze Downloads" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="AnalyzeDownloads_Click"/>
                    <Button Content="Clear All Records" Style="{StaticResource SecondaryButton}" Click="ClearAllDownloadRecords_Click"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="0,0,0,16">
                    <TextBlock Text="Search for a download across every account" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="DownloadSearchBox" Style="{StaticResource FilterTextBox}" Width="280" Margin="0,0,10,0" KeyDown="DownloadSearchBox_KeyDown"/>
                        <Button Content="Search Downloads" Style="{StaticResource SecondaryButton}" Click="SearchDownloads_Click"/>
                    </StackPanel>
                    <ProgressBar x:Name="DownloadsProgressBar" Style="{StaticResource ScanBar}" Margin="0,10,0,0" Width="320" HorizontalAlignment="Left" Visibility="Collapsed"/>
                </StackPanel>
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                    <StackPanel x:Name="DownloadsResultsPanel">
                        <TextBlock Text="Chrome's download history and your actual Downloads folder are shown separately — cleaning one never touches the other." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= EXTENSIONS ================= -->
            <Grid x:Name="Page_Extensions" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Extensions" Style="{StaticResource PageTitle}"/>
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Account" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ExtensionsAccountSelector" Style="{StaticResource AccountComboBox}" DisplayMemberPath="Label"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Scan Extensions" Style="{StaticResource PrimaryButton}" Click="ScanExtensions_Click"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="0,0,0,14">
                    <TextBlock Text="Search for an extension across every account" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="ExtensionSearchBox" Style="{StaticResource FilterTextBox}" Width="280" Margin="0,0,10,0" KeyDown="ExtensionSearchBox_KeyDown"/>
                        <Button Content="Search Extension" Style="{StaticResource SecondaryButton}" Click="SearchExtension_Click"/>
                    </StackPanel>
                    <ProgressBar x:Name="ExtensionsProgressBar" Style="{StaticResource ScanBar}" Margin="0,10,0,0" Width="320" HorizontalAlignment="Left" Visibility="Collapsed"/>
                </StackPanel>
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                    <ItemsControl x:Name="ExtensionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,18">
                                    <TextBlock Text="{Binding ProfileLabel}" Foreground="{StaticResource Silver}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ProfileCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                                                            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11">
                                                                <Run Text="v"/>
                                                                <Run Text="{Binding Version}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Foreground="{StaticResource Silver}" FontSize="13" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Content="Remove" Style="{StaticResource RowActionButton}" Tag="{Binding}" Click="RemoveExtension_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ================= COOKIES ================= -->
            <Grid x:Name="Page_Cookies" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Cookies" Style="{StaticResource PageTitle}"/>
                <TextBlock Grid.Row="1" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Cookies are Protected — Safe Cleanup never touches them. Deleting a site's cookies here is always an explicit, separate action and signs you out of that site. Chrome must be closed."/>
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Account" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CookiesAccountSelector" Style="{StaticResource AccountComboBox}" DisplayMemberPath="Label"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Scan Cookies" Style="{StaticResource PrimaryButton}" Click="ScanCookies_Click"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Margin="0,0,0,14">
                    <TextBlock Text="Search for a site's cookies across every account" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="CookieSearchBox" Style="{StaticResource FilterTextBox}" Width="280" Margin="0,0,10,0" KeyDown="CookieSearchBox_KeyDown"/>
                        <Button Content="Search Cookies" Style="{StaticResource SecondaryButton}" Click="SearchCookies_Click"/>
                    </StackPanel>
                    <ProgressBar x:Name="CookiesProgressBar" Style="{StaticResource ScanBar}" Margin="0,10,0,0" Width="320" HorizontalAlignment="Left" Visibility="Collapsed"/>
                </StackPanel>
                <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                    <ItemsControl x:Name="CookiesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,18">
                                    <TextBlock Text="{Binding ProfileLabel}" Foreground="{StaticResource Silver}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ProfileCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Domain}" Foreground="{StaticResource TextPrimary}" FontSize="14" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding CookieCountDisplay}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Content="Delete" Style="{StaticResource RowActionButton}" Tag="{Binding}" Click="DeleteCookiesForDomain_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ================= CLEANUP ================= -->
            <Grid x:Name="Page_Cleanup" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Cleanup" Style="{StaticResource PageTitle}"/>
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Safe Cleanup removes only the disposable cache-type data listed below — the same items marked 'Safe' on the Storage page. Nothing marked Review or Protected is ever touched here, and nothing is deleted until you click the button below and confirm."/>
                    <TextBlock x:Name="CleanupSummaryText" Text="Run a scan from the Dashboard first." Foreground="{StaticResource FogWhite}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <TextBlock Text="What will be cleaned" Foreground="{StaticResource FogWhite}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="CleanupPreviewList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ProfileCard}" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Foreground="{StaticResource Silver}" FontSize="13" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SafeCleanupButton" Content="Clean Safe Items" Style="{StaticResource PrimaryButton}" Click="SafeCleanup_Click" IsEnabled="False"/>
                    </StackPanel>
                    <ProgressBar x:Name="CleanupProgressBar" Style="{StaticResource ScanBar}" Margin="0,10,0,0" Width="360" HorizontalAlignment="Left" Visibility="Collapsed"/>
                </StackPanel>
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                    <StackPanel>
                        <TextBlock Text="Cleanup log" Foreground="{StaticResource FogWhite}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="CleanupLogText" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"
                                   Text="Nothing has been cleaned yet. Click &quot;Clean Safe Items&quot; above to begin — a line-by-line log of exactly what was removed and how much space it freed will appear here."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= REPORTS ================= -->
            <Grid x:Name="Page_Reports" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Reports" Style="{StaticResource PageTitle}"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Generate Report" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="GenerateReport_Click"/>
                    <Button Content="Download (TXT)" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="ExportReport_Click"/>
                    <Button x:Name="OpenReportFolderButton" Content="Open Folder" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="OpenReportFolder_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="2" x:Name="ReportStatusText" Text="Click Generate Report to see a full breakdown of your last scan here. Download saves the same report as a text file." Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <Border Grid.Row="3" Style="{StaticResource ProfileCard}" Padding="16,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                        <TextBlock x:Name="GeneratedReportText" Foreground="{StaticResource TextPrimary}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"
                                   Text="No report generated yet."/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ================= HELP ================= -->
            <Grid x:Name="Page_Help" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Help" Style="{StaticResource PageTitle}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HelpTopicTitle}" Text="Getting Started" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource HelpTopicBody}" Text="1) Scan Chrome from the Dashboard. 2) Review what's using space. 3) Check the safety level of anything you're unsure about. 4) Clean only what's marked Safe. 5) See how much space you got back."/>

                        <TextBlock Style="{StaticResource HelpTopicTitle}" Text="How BrowserCare Works"/>
                        <TextBlock Style="{StaticResource HelpTopicBody}" Text="BrowserCare reads Chrome's own folders and databases on your computer to figure out what's taking up space. It never uploads anything anywhere — everything happens locally."/>

                        <TextBlock Style="{StaticResource HelpTopicTitle}" Text="How to Scan"/>
                        <TextBlock Style="{StaticResource HelpTopicBody}" Text="Quick Scan checks only disposable caches — it's fast and always safe to run. Deep Scan also looks at site data, IndexedDB, and extensions, so it takes longer but gives you the full picture."/>

                        <TextBlock Style="{StaticResource HelpTopicTitle}" Text="Understanding Safety Levels"/>
                        <TextBlock Style="{StaticResource HelpTopicBody}" Text="Safe (green): Chrome can recreate this automatically — always fine to remove. Review (yellow): may sign you out of a site or reset an app's data — decide item by item. Protected (red): passwords, cookies, bookmarks, and real files — BrowserCare never deletes these automatically."/>

                        <TextBlock Style="{StaticResource HelpTopicTitle}" Text="Profiles Explained"/>
                        <TextBlock Style="{StaticResource HelpTopicBody}" Text="Each Chrome profile is a separate identity — think of it like a separate user account inside Chrome. BrowserCare shows you Chrome's own name for each profile rather than the confusing 'Profile 15' folder name where possible."/>

                        <TextBlock Style="{StaticResource HelpTopicTitle}" Text="Cache Explained"/>
                        <TextBlock Style="{StaticResource HelpTopicBody}" Text="Temporary files that help pages and Chrome itself load faster. Removing cache is safe — Chrome simply rebuilds it as you browse."/>

                        <TextBlock Style="{StaticResource HelpTopicTitle}" Text="History, Downloads &amp; Extensions"/>
                        <TextBlock Style="{StaticResource HelpTopicBody}" Text="History and Downloads read Chrome's own database in read-only mode (a temporary copy — Chrome is never modified while it's running). Extensions lists what's installed per profile so oversized ones are easy to spot; removing one is always an explicit action you choose."/>

                        <TextBlock Style="{StaticResource HelpTopicTitle}" Text="Troubleshooting"/>
                        <TextBlock Style="{StaticResource HelpTopicBody}" Text="If Chrome is open, some files may be temporarily locked — BrowserCare skips locked items rather than failing the whole scan. If a database can't be read, it will say so rather than showing made-up numbers."/>

                        <TextBlock Style="{StaticResource HelpTopicTitle}" Text="Report a Problem"/>
                        <TextBlock Style="{StaticResource HelpTopicBody}" Text="Useful details to include: BrowserCare version, Windows version, which scan mode you used, the exact error message, and whether Chrome was open. Never include passwords, cookies, browsing history, or account credentials in a bug report."/>

                        <TextBlock Style="{StaticResource HelpTopicTitle}" Text="Contact"/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13">
                            <Run Text="General: "/><Run Text="jssofttoolproducts@gmail.com" Foreground="{StaticResource TextPrimary}"/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,2,0,0">
                            <Run Text="Support: "/><Run Text="support.jssofttoolproducts@gmail.com" Foreground="{StaticResource TextPrimary}"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= SETTINGS ================= -->
            <Grid x:Name="Page_Settings" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource PageTitle}"/>
                <StackPanel Grid.Row="1">
                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4">
                        <Run Text="This PC: "/><Run x:Name="SettingsPcNameText" Text="—" Foreground="{StaticResource FogWhite}"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,20">
                        <Run Text="Chrome data: "/><Run x:Name="SettingsChromePathText" Text="—" Foreground="{StaticResource FogWhite}"/>
                    </TextBlock>
                    <CheckBox x:Name="Setting_StartWithWindows" Content="Start with Windows" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                    <CheckBox x:Name="Setting_RequireConfirmation" Content="Require confirmation before cleanup" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                    <CheckBox x:Name="Setting_CreateBackups" Content="Create backups before Review-level cleanup" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                    <CheckBox x:Name="Setting_IncludeInactive" Content="Include inactive profiles when scanning" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20"/>
                    <Button Content="Save Settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
                    <TextBlock x:Name="SettingsSavedText" Foreground="{StaticResource SafeGreen}" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ================= PRIVACY ================= -->
            <Grid x:Name="Page_Privacy" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Privacy" Style="{StaticResource PageTitle}"/>
                <StackPanel Grid.Row="1">
                    <TextBlock Style="{StaticResource HelpTopicTitle}" Text="Local Processing" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource HelpTopicBody}" Text="BrowserCare analyzes Chrome entirely on your computer. Nothing is uploaded."/>
                    <TextBlock Style="{StaticResource HelpTopicTitle}" Text="No Password Collection"/>
                    <TextBlock Style="{StaticResource HelpTopicBody}" Text="BrowserCare does not read or collect your saved Chrome passwords."/>
                    <TextBlock Style="{StaticResource HelpTopicTitle}" Text="No Cookie Collection"/>
                    <TextBlock Style="{StaticResource HelpTopicBody}" Text="Cookies are classified as Protected and are never read or uploaded."/>
                    <TextBlock Style="{StaticResource HelpTopicTitle}" Text="No Browsing History Upload"/>
                    <TextBlock Style="{StaticResource HelpTopicBody}" Text="History is read locally to show you totals and top sites — it never leaves your computer."/>
                    <TextBlock Style="{StaticResource HelpTopicTitle}" Text="No Account Credentials"/>
                    <TextBlock Style="{StaticResource HelpTopicBody}" Text="BrowserCare never asks for your Google account credentials."/>
                    <TextBlock Style="{StaticResource HelpTopicTitle}" Text="No Telemetry"/>
                    <TextBlock Style="{StaticResource HelpTopicBody}" Text="Version 1.0 sends zero telemetry of any kind."/>
                </StackPanel>
            </Grid>

            <!-- ================= ABOUT ================= -->
            <Grid x:Name="Page_About" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column: identity, developer, contact -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,10,0,0">
                    <Image Source="Assets/logo.png" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="BrowserCare" Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Understand. Clean. Protect." Foreground="{StaticResource Silver}" FontSize="13" Margin="0,2,0,12"/>
                    <TextBlock x:Name="AboutVersionText" Text="Version 1.0.0" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,16"/>

                    <TextBlock Text="Developed by" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBlock Text="Jayasubramani S" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    <TextBlock Text="Chip-X — a JS SoftTools product" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Contact" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="ContactGeneral_Click"/>
                        <Button Content="Support" Style="{StaticResource SecondaryButton}" Click="ContactSupport_Click"/>
                    </StackPanel>

                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,2">
                        <Run Text="General: "/><Run Text="jssofttoolproducts@gmail.com" Foreground="{StaticResource TextPrimary}"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,16">
                        <Run Text="Support: "/><Run Text="support.jssofttoolproducts@gmail.com" Foreground="{StaticResource TextPrimary}"/>
                    </TextBlock>

                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap"
                               Text="BrowserCare is an independent utility and is not affiliated with or endorsed by Google. Google Chrome is a trademark of Google LLC."/>
                </StackPanel>

                <!-- Right column: purpose & legal notice, fills the space that used to sit empty -->
                <Border Grid.Column="2" BorderBrush="{StaticResource ProtectedRed}" BorderThickness="1" Background="{StaticResource Card}"
                        Padding="16,14" VerticalAlignment="Top" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Purpose &amp; Legal Notice" Foreground="{StaticResource ProtectedRed}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Foreground="{StaticResource FogWhite}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="This app is created to clean and maintain Google Chrome only."/>
                        <TextBlock Foreground="{StaticResource FogWhite}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="It is built for non-commercial use, as a student project — not a commercial product."/>
                        <TextBlock Foreground="{StaticResource FogWhite}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Reverse engineering, cracking, tampering with, or redistributing a modified version of this software is not permitted and may constitute a criminal offense under applicable law."/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                   Text="BrowserCare is provided as-is, without warranty of any kind. The developer is not liable for any damage, data loss, or misuse resulting from use or modification of this software. By using BrowserCare, you agree to use it only for its stated purpose."/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
